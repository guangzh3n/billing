# MongoDB
MONGO_URI=mongodb://mongo:27017/billing

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_32chars
JWT_REFRESH_SECRET=change_this_refresh_secret_32chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Service ports (internal)
GATEWAY_PORT=3000
AUTH_PORT=3001
TENANT_PORT=3002
INVOICE_PORT=3003
CUSTOMER_PORT=3004
PRODUCT_PORT=3005
PAYMENT_PORT=3006
EINVOICE_PORT=3007

# Service internal URLs (used by gateway and inter-service calls)
AUTH_SERVICE_URL=http://auth-service:3001
TENANT_SERVICE_URL=http://tenant-service:3002
INVOICE_SERVICE_URL=http://invoice-service:3003
CUSTOMER_SERVICE_URL=http://customer-service:3004
PRODUCT_SERVICE_URL=http://product-service:3005
PAYMENT_SERVICE_URL=http://payment-service:3006
EINVOICE_SERVICE_URL=http://einvoice-service:3007

# Initial super admin (created on first run)
SUPER_ADMIN_EMAIL=admin@billing.com
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Super Admin

NODE_ENV=development
